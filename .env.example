# Copy to .env and fill in. Never commit .env.
# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ribm_dev?schema=public"

# Initial ADMIN account created by `npm run db:seed`. Required for seeding; no defaults.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="RIBM Admin"
